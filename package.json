{
  "name": "mymem",
  "version": "0.5.0",
  "description": "Shared memory for every AI agent, on every device — free, open-source, MCP-native.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mymem": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
